<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Id="ThreeByThree.Centar.Scoreboard"
           Name="3x3 Centar Scoreboard"
           Manufacturer="3x3 Centar"
           Version="$(Version)"
           Scope="perMachine">

    <SummaryInformation Description="3x3 Centar offline basketball scoreboard controller and public display" />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="WINDOWSBUILDNUMBER" Secure="yes">
      <RegistrySearch Id="WindowsBuildNumberSearch"
                      Root="HKLM"
                      Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
                      Name="CurrentBuildNumber"
                      Type="raw" />
    </Property>
    <Launch Condition="Installed OR (WINDOWSBUILDNUMBER &gt;= 14393)"
            Message="3x3 Centar Scoreboard requires 64-bit Windows 10 version 1607 or later." />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="3x3 Centar Scoreboard">
        <Files Include="$(PublishDirectory)\**" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="3x3 Centar Scoreboard">
        <Component Id="ApplicationShortcuts" Guid="*">
          <Shortcut Id="StartMenuShortcut"
                    Name="3x3 Centar Scoreboard"
                    Description="Open the 3x3 Centar scoreboard controller"
                    Target="[INSTALLFOLDER]3x3Centar.Scoreboard.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <Shortcut Id="DesktopShortcut"
                    Directory="DesktopFolder"
                    Name="3x3 Centar Scoreboard"
                    Description="Open the 3x3 Centar scoreboard controller"
                    Target="[INSTALLFOLDER]3x3Centar.Scoreboard.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
          <RegistryValue Root="HKCU"
                         Key="Software\3x3 Centar\Scoreboard"
                         Name="Installed"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />
  </Package>
</Wix>
