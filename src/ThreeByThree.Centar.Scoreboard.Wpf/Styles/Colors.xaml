<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BlackColor">#000000</Color>
    <Color x:Key="PanelColor">#171717</Color>
    <Color x:Key="PanelRaisedColor">#242424</Color>
    <Color x:Key="WhiteColor">#FFFFFF</Color>
    <Color x:Key="GreyColor">#C4C4C4</Color>
    <Color x:Key="DisabledColor">#666666</Color>
    <Color x:Key="AccentColor">#FF5252</Color>

    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource BlackColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="PanelRaisedBrush" Color="{StaticResource PanelRaisedColor}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource WhiteColor}" />
    <SolidColorBrush x:Key="GreyBrush" Color="{StaticResource GreyColor}" />
    <SolidColorBrush x:Key="DisabledBrush" Color="{StaticResource DisabledColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
</ResourceDictionary>
