<Window x:Class="ThreeByThree.Centar.Scoreboard.Wpf.Views.ScoreboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="3x3 Centar Scoreboard"
        Width="960"
        Height="540"
        MinWidth="640"
        MinHeight="360"
        Background="Black"
        Focusable="False"
        ShowActivated="False"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">
    <Viewbox Stretch="Uniform">
        <Grid Width="1920"
              Height="1080"
              Background="{StaticResource BlackBrush}"
              TextElement.FontFamily="{StaticResource AppFontFamily}"
              TextElement.Foreground="{StaticResource WhiteBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="180" />
                <RowDefinition Height="740" />
                <RowDefinition Height="160" />
            </Grid.RowDefinitions>

            <Grid Margin="80,26,80,8">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <Rectangle Width="90"
                                   Height="90"
                                   Fill="{StaticResource WhiteBrush}">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="pack://application:,,,/Assets/Branding/3x3logo.png"
                                            Stretch="Uniform" />
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <TextBlock Margin="24,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="54"
                                   FontWeight="Black"
                                   Text="3X3 CENTAR" />
                    </StackPanel>
                    <TextBlock Margin="0,10,0,0"
                               HorizontalAlignment="Center"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource GreyBrush}"
                               Text="{Binding Category}"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="90,0,90,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="114" />
                    <RowDefinition Height="360" />
                    <RowDefinition Height="230" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="540" />
                    <ColumnDefinition Width="600" />
                    <ColumnDefinition Width="540" />
                </Grid.ColumnDefinitions>

                <TextBlock Margin="30,0,42,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="58"
                           FontWeight="Black"
                           Text="{Binding HomeName}"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2"
                           Margin="42,0,30,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="58"
                           FontWeight="Black"
                           Text="{Binding AwayName}"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <Border Grid.Row="1"
                        Margin="30,0,42,0"
                        BorderBrush="{StaticResource WhiteBrush}"
                        BorderThickness="6"
                        CornerRadius="4">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="270"
                               FontWeight="Black"
                               LineHeight="280"
                               Text="{Binding HomeScore}"
                               TextAlignment="Center" />
                </Border>

                <Grid Grid.Row="1" Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="72" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Bottom"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource GreyBrush}"
                               Text="GAME CLOCK" />
                    <TextBlock Grid.Row="1"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="164"
                               FontWeight="Black"
                               Text="{Binding GameClock}"
                               TextAlignment="Center" />
                </Grid>

                <Border Grid.Row="1"
                        Grid.Column="2"
                        Margin="42,0,30,0"
                        BorderBrush="{StaticResource WhiteBrush}"
                        BorderThickness="6"
                        CornerRadius="4">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="270"
                               FontWeight="Black"
                               LineHeight="280"
                               Text="{Binding AwayScore}"
                               TextAlignment="Center" />
                </Border>

                <StackPanel Grid.Row="2"
                            Margin="30,18,42,0"
                            HorizontalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Foreground="{Binding HomeFoulColorHex}"
                               Text="FOULS" />
                    <Border Width="154"
                            Height="116"
                            Margin="0,8,0,0"
                            BorderBrush="{Binding HomeFoulColorHex}"
                            BorderThickness="4"
                            CornerRadius="3">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding HomeFoulColorHex}"
                                   FontSize="74"
                                   FontWeight="Black"
                                   Text="{Binding HomeFouls}" />
                    </Border>
                </StackPanel>

                <Border Grid.Row="2"
                        Grid.Column="1"
                        Width="300"
                        Height="208"
                        Margin="0,18,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Background="{Binding ShotClockBackgroundHex}"
                        CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="54" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Bottom"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="Black"
                                   Text="SHOT CLOCK" />
                        <TextBlock Grid.Row="1"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="122"
                                   FontWeight="Black"
                                   Foreground="Black"
                                   Text="{Binding ShotClock}"
                                   TextAlignment="Center" />
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2"
                            Grid.Column="2"
                            Margin="42,18,30,0"
                            HorizontalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Foreground="{Binding AwayFoulColorHex}"
                               Text="FOULS" />
                    <Border Width="154"
                            Height="116"
                            Margin="0,8,0,0"
                            BorderBrush="{Binding AwayFoulColorHex}"
                            BorderThickness="4"
                            CornerRadius="3">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding AwayFoulColorHex}"
                                   FontSize="74"
                                   FontWeight="Black"
                                   Text="{Binding AwayFouls}" />
                    </Border>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" Margin="90,14,90,28">
                <Border Background="{StaticResource PanelBrush}"
                        CornerRadius="4"
                        Visibility="{Binding StatusBannerVisibility}">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="54"
                               FontWeight="Black"
                               Text="{Binding StatusBanner}" />
                </Border>
                <Border Background="{StaticResource AccentBrush}"
                        CornerRadius="4"
                        Visibility="{Binding DecisionVisibility}">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="54"
                               FontWeight="Black"
                               Foreground="Black"
                               Text="{Binding DecisionMessage}" />
                </Border>
            </Grid>

            <Border Grid.RowSpan="3"
                    Panel.ZIndex="100"
                    Background="Black"
                    Visibility="{Binding BlackoutVisibility}" />
        </Grid>
    </Viewbox>
</Window>
