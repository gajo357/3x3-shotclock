<Window x:Class="ThreeByThree.Centar.Scoreboard.Wpf.Views.NewGameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ThreeByThree.Centar.Scoreboard.Domain.Models;assembly=ThreeByThree.Centar.Scoreboard.Domain"
        Title="New game"
        Width="620"
        Height="780"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="28"
                   FontWeight="Bold"
                   Text="PREPARE NEW GAME" />

        <ScrollViewer Grid.Row="1"
                      Margin="0,16"
                      VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.ColumnSpan="2">
                    <Label Content="Tournament" />
                    <TextBox Text="{Binding TournamentName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Label Content="Scheduled game ID" />
                    <TextBox Text="{Binding ScheduledGameId, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1">
                    <Label Content="Court" />
                    <TextBox Text="{Binding CourtName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.ColumnSpan="2">
                    <Label Content="Category" />
                    <TextBox Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="3">
                    <Label Content="Scheduled date (optional)" />
                    <DatePicker SelectedDate="{Binding ScheduledDate}" />
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="1">
                    <Label Content="Scheduled time (HH:mm, optional)" />
                    <TextBox Text="{Binding ScheduledTime, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <GroupBox Grid.Row="4"
                          Margin="4,14,4,4"
                          Padding="12"
                          Header="HOME TEAM"
                          Foreground="{StaticResource WhiteBrush}">
                    <StackPanel>
                        <TextBox Text="{Binding HomeName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Text="{Binding HomeColorHex, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Grid.Row="4"
                          Grid.Column="1"
                          Margin="4,14,4,4"
                          Padding="12"
                          Header="AWAY TEAM"
                          Foreground="{StaticResource WhiteBrush}">
                    <StackPanel>
                        <TextBox Text="{Binding AwayName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Text="{Binding AwayColorHex, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </GroupBox>

                <StackPanel Grid.Row="5">
                    <Label Content="Game duration (minutes)" />
                    <TextBox Text="{Binding GameMinutes, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Row="5" Grid.Column="1">
                    <Label Content="Shot clock (seconds)" />
                    <TextBox Text="{Binding ShotClockSeconds, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <GroupBox Grid.Row="6"
                          Grid.ColumnSpan="2"
                          Margin="4,14,4,4"
                          Padding="12"
                          Header="COIN TOSS"
                          Foreground="{StaticResource WhiteBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <Label Content="Winner" />
                            <ComboBox SelectedValue="{Binding CoinTossWinner}"
                                      SelectedValuePath="Tag">
                                <ComboBoxItem Content="{Binding HomeName}"
                                              Tag="{x:Static models:TeamSide.Home}" />
                                <ComboBoxItem Content="{Binding AwayName}"
                                              Tag="{x:Static models:TeamSide.Away}" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <Label Content="Winner chooses the ball" />
                            <ComboBox SelectedValue="{Binding CoinTossSelection}"
                                      SelectedValuePath="Tag">
                                <ComboBoxItem Content="AT GAME START"
                                              Tag="{x:Static models:CoinTossChoice.OpeningPossession}" />
                                <ComboBoxItem Content="AT OVERTIME"
                                              Tag="{x:Static models:CoinTossChoice.OvertimePossession}" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </GroupBox>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button IsCancel="True" Content="CANCEL" />
            <Button IsDefault="True" Click="OnCreate" Content="CREATE GAME" />
        </StackPanel>
    </Grid>
</Window>
