<Window x:Class="ThreeByThree.Centar.Scoreboard.Wpf.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scoreboard settings"
        Width="560"
        Height="560"
        MinWidth="520"
        MinHeight="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="26" FontWeight="Bold" Text="DISPLAY &amp; AUDIO" />

        <StackPanel Grid.Row="1" Margin="0,22,0,0">
            <TextBlock Margin="0,0,0,6"
                       Foreground="{StaticResource GreyBrush}"
                       Text="PUBLIC SCOREBOARD DISPLAY" />
            <ComboBox ItemsSource="{Binding MonitorChoices}"
                      SelectedItem="{Binding SelectedMonitor}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <CheckBox Margin="0,12,0,0"
                      Content="Keep public scoreboard above other windows"
                      IsChecked="{Binding ScoreboardTopmost}" />
        </StackPanel>

        <Separator Grid.Row="2" Margin="0,20" />

        <StackPanel Grid.Row="3">
            <CheckBox FontSize="17"
                      FontWeight="SemiBold"
                      Content="Enable buzzer audio"
                      IsChecked="{Binding AudioEnabled}" />
            <DockPanel Margin="0,14,0,0">
                <TextBlock DockPanel.Dock="Right"
                           Margin="14,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="Bold"
                           Text="{Binding VolumePercent, StringFormat={}{0}%}" />
                <TextBlock DockPanel.Dock="Left"
                           Margin="0,0,14,0"
                           VerticalAlignment="Center"
                           Text="Volume" />
                <Slider Minimum="0"
                        Maximum="100"
                        TickFrequency="5"
                        IsSnapToTickEnabled="True"
                        Value="{Binding VolumePercent}" />
            </DockPanel>
            <Button Margin="0,12,0,0"
                    HorizontalAlignment="Left"
                    Command="{Binding TestSoundCommand}"
                    Content="TEST BUZZER" />
            <TextBlock Margin="0,10,0,0"
                       Foreground="{StaticResource GreyBrush}"
                       Text="Audio uses the Windows default output device. Select HDMI or the venue sound system in Windows before play."
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="4"
                Margin="0,20,0,0"
                Padding="14"
                Background="{StaticResource PanelBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Rectangle Width="52"
                           Height="52"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Fill="{StaticResource WhiteBrush}">
                    <Rectangle.OpacityMask>
                        <ImageBrush ImageSource="pack://application:,,,/Assets/Branding/3x3logo.png"
                                    Stretch="Uniform" />
                    </Rectangle.OpacityMask>
                </Rectangle>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Foreground="{StaticResource GreyBrush}"
                               FontSize="12"
                               Text="PUBLISHED BY" />
                    <TextBlock FontSize="19"
                               FontWeight="Bold"
                               Text="3X3 Centar" />
                    <TextBlock Margin="0,4,0,0">
                        <Hyperlink Foreground="{StaticResource AccentBrush}"
                                   NavigateUri="https://3x3centar.com"
                                   RequestNavigate="OnPublisherLinkRequestNavigate">
                            3x3centar.com
                        </Hyperlink>
                        <Run Foreground="{StaticResource DisabledBrush}" Text="  &#x2022;  " />
                        <Hyperlink Foreground="{StaticResource AccentBrush}"
                                   NavigateUri="mailto:3x3centar@gmail.com"
                                   RequestNavigate="OnPublisherLinkRequestNavigate">
                            3x3centar@gmail.com
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="5"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button MinWidth="110" Click="OnCancel" Content="CANCEL" />
            <Button MinWidth="110" Click="OnSave" Content="SAVE" />
        </StackPanel>
    </Grid>
</Window>
